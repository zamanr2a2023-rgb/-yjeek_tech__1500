<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/success_dialog"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true">

            <ImageView
                android:id="@+id/success_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:layout_marginBottom="@dimen/page_padding" />

            <TextView
                android:id="@+id/transaction_success_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/success_icon"
                android:layout_centerHorizontal="true"
                android:layout_marginBottom="@dimen/item_padding"
                android:gravity="center"
                android:tag="bold"
                android:textAllCaps="true"
                android:textColor="@color/transaction_status_grey"
                android:textSize="@dimen/text_size_xlarge" />

            <TextView
                android:id="@+id/transaction_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/transaction_success_text"
                android:layout_centerHorizontal="true"
                android:layout_marginLeft="@dimen/page_padding"
                android:layout_marginRight="@dimen/page_padding"
                android:layout_marginBottom="@dimen/padding_xxlarge"
                android:gravity="center"
                android:textColor="@color/transaction_status_grey"
                android:textSize="@dimen/text_size_medium"
                android:visibility="gone" />

            <View
                android:id="@+id/view"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_below="@+id/transaction_message"
                android:layout_marginStart="@dimen/padding_xlarge"
                android:layout_marginEnd="@dimen/padding_xlarge"
                android:layout_marginBottom="@dimen/padding_xxlarge"
                android:textColor="@color/transaction_status_grey"
                android:visibility="gone" />

            <TextView
                android:id="@+id/amount_text_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/view"
                android:layout_centerHorizontal="true"
                android:gravity="center"
                android:tag="bold"
                android:textColor="@color/transaction_status_grey"
                android:textSize="@dimen/text_size_xlarge" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/amount_text_view"
                android:layout_centerHorizontal="true"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/card_used_text_view"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:tag="bold"
                    android:textColor="@color/transaction_status_grey"
                    android:textSize="@dimen/text_size_small" />

                <TextView
                    android:id="@+id/merchant_text_view"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textColor="@color/transaction_status_grey"
                    android:textSize="@dimen/text_size_medium" />

            </LinearLayout>

        </RelativeLayout>

    </RelativeLayout>

</LinearLayout>